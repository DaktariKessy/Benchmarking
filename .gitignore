# Python
__pycache__/
*.py[cod]
*.pyo
*.bak
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
env/
.venv/
*_env/
unik3d_env/

# Model weights and checkpoints
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
